{
  "name": "arabic-village",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs && node tests/e2e/voice-ai.mjs",
    "start": "tsx server/index.ts",
    "audio:build": "tsx scripts/build-audio.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^3.2.7"
  }
}
