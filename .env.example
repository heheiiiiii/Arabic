# Arabic Village 서버 환경 변수 예시
# 이 파일을 .env 로 복사해 값을 채우지 말고, 실행 환경(셸·호스팅 플랫폼)의 환경 변수로 설정하세요.
# (서버는 .env 파일을 자동으로 읽지 않습니다. 예: `ANTHROPIC_API_KEY=... npm start`)
# 키를 넣지 않아도 게임·책상 학습·연습 모드 대화·미리 만든 음성은 동작합니다.

# ── AI 자유 회화 (Anthropic Claude) ──
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low            # low | medium | high (대화는 low 권장: 빠르고 저렴)
# AI_TIMEOUT_MS=30000
# AI_DAILY_LIMIT=500       # 서버 전체 하루 AI 요청 상한 (비용 보호)
# VILLAGE_ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── 음성 출력 (TTS) — 위에서부터 설정된 것을 먼저 사용 ──
# TTS_PROVIDERS=azure,openai,espeak
# Azure AI Speech (자연스러운 MSA 신경망 음성 ar-SA)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_TTS_VOICE=ar-SA-HamedNeural   # 또는 ar-SA-ZariyahNeural
# OpenAI TTS
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# espeak-ng (로컬, 무료, 키 불필요: apt-get install espeak-ng ffmpeg)
# ESPEAK_VOICE=ar
# TTS_CACHE_DIR=.cache/tts

# ── 음성 인식 (STT) — OpenAI 호환 /audio/transcriptions ──
# STT_API_KEY=             # 비우면 OPENAI_API_KEY 사용
# STT_BASE_URL=https://api.openai.com/v1   # 자체 Whisper 서버(OpenAI 호환)도 가능
# STT_MODEL=whisper-1
# STT_TIMEOUT_MS=20000

# ── 서버 ──
# PORT=8787
# ALLOWED_ORIGINS=https://example.com   # 다른 도메인의 게임 페이지가 이 API를 부를 때만
